{
  "name": "agnes-convex-submitter",
  "version": "1.0.0",
  "description": "Scheduled Convex backend service to reliably submit pending Agnes scene videos with resilient capacity retries and key rotation",
  "type": "module",
  "main": "dist/standalone.js",
