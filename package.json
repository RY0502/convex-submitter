    "submit:once": "tsc && node dist/standalone.js"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "convex": "^1.17.4",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
