# --- Convex Cloud Configuration ---
CONVEX_URL=https://your-project.convex.cloud/
CONVEX_DEPLOY_KEY=

# --- Turso Database (Source of Truth for Episodes and Agnes Scene Generations) ---
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# --- Agnes Video API Keys (Multi-lane account rotation) ---
AGNES_API_KEY_1=
AGNES_API_KEY_2=
AGNES_API_KEY_3=
AGNES_API_KEY_4=
AGNES_API_KEY_5=
AGNES_API_KEY_6=
AGNES_API_KEY_7=

# --- Agnes Model and Strategy Settings ---
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
AGNES_CAPACITY_MAX_RETRIES=20
AGNES_CAPACITY_RETRY_INTERVAL_MS=5000
AGNES_CAPACITY_RETRY_JITTER_MS=3000
AGNES_MAX_SUBMISSIONS_PER_RUN=10
SUBMISSION_CRON_INTERVAL_MINUTES=2
